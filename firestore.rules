rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /study_state/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validPlan() {
        return request.resource.data.keys().hasAll(['schema', 'version', 'payload', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['schema', 'version', 'payload', 'updatedAt'])
          && request.resource.data.schema == 1
          && request.resource.data.version is int
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 700000
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow list: if false;
      allow create: if owner() && validPlan() && request.resource.data.version == 1;
      allow update: if owner() && validPlan()
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
